# ── Supabase ──────────────────────────────────────────────────────────────
# Settings -> API Keys. See docs/SUPABASE_SETUP.md before filling these in.
# Missing: no authentication, and every DB call fails.
#
# Naming note: newer Supabase projects issue "publishable" (sb_publishable_)
# and "secret" (sb_secret_) keys rather than the legacy anon/service_role
# JWTs. The variable names below keep the older wording; the publishable key
# goes in ANON_KEY and the secret key in SERVICE_ROLE_KEY. Do not mix the two
# formats — use whichever tab your dashboard defaults to.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only. Bypasses all security — must never reach a client bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Database ──────────────────────────────────────────────────────────────
# Pooled (port 6543), used by the app at runtime.
# Missing pgbouncer=true causes intermittent prepared-statement errors.
DATABASE_URL=""
# Unpooled (port 5432), used ONLY by prisma migrate.
# Missing: migrations fail with confusing advisory-lock errors.
DIRECT_URL=""
